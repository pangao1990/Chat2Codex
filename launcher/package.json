{
  "name": "chat2codex-launcher",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Desktop control center for Chat2Codex",
  "author": "Chat2Codex contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "bun run scripts/dev.cjs",
    "audit": "bun audit",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build": "bun run typecheck && bun run build:renderer",
    "build:runtime": "bun run scripts/prepare-runtime.cjs",
    "package": "bun run build && bun run build:runtime && bun run scripts/package.cjs",
    "package:mac": "bun run build && bun run build:runtime && bun run scripts/package.cjs --mac",
    "package:win": "bun run build && bun run build:runtime && bun run scripts/package.cjs --win",
    "package:linux": "bun run build && bun run build:runtime && bun run scripts/package.cjs --linux",
    "smoke:package": "bun run scripts/smoke-package.cjs",
    "test": "node --test tests/*.test.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.10.7",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.6"
  },
  "build": {
    "appId": "dev.chat2codex.app",
    "productName": "Chat2Codex",
    "artifactName": "chat2codex-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/linux-appimage-runner.sh"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "assets/linux-appimage-runner.sh",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signIgnore": [
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]runtime[/\\\\]bun$"
      ],
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis"]
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icon.png",
      "target": ["AppImage"]
    },
    "nsis": {
      "guid": "3f0797f7-49e5-5d71-bca7-47c40cb899f1",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
